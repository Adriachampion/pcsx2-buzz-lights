+#ifdef _WIN32
+	static bool buzz_write_lights(SDL_hid_device* device, const std::array<u8, 4>& lights)
+	{
+		// Windows HID expects a leading report ID (zero for this unnumbered report).
+		const std::array<u8, 8> report = {0, 0, lights[0], lights[1], lights[2], lights[3], 0, 0};
+		return SDL_hid_write(device, report.data(), report.size()) == static_cast<int>(report.size());
+	}
+
+	void BuzzState::SetLights(const std::array<u8, 4>& lights)
+	{
+		if (!physical_lights)
+			return;
+
+		const u32 generation = SDL_hid_device_change_count();
+		if (generation != light_device_generation)
+		{
+			CloseLights();
+			light_device_generation = generation;
+		}
+
+		if (light_device && last_lights == lights)
+			return;
+
+		if (!light_device)
+		{
+			const auto now = std::chrono::steady_clock::now();
+			if (now < next_light_open)
+				return;
+
+			next_light_open = now + std::chrono::seconds(1);
+
+			// The button mappings do not identify a physical set for output.
+			// With multiple matching sets connected, leave their lights alone.
+			SDL_hid_device_info* devices = SDL_hid_enumerate(0x054c, 0x0002);
+			if (devices && !devices->next)
+				light_device = SDL_hid_open_path(devices->path);
+			SDL_hid_free_enumeration(devices);
+			if (!light_device)
+				return;
+		}
+
+		if (buzz_write_lights(light_device, lights))
+		{
+			last_lights = lights;
+		}
+		else
+		{
+			SDL_hid_close(light_device);
+			light_device = nullptr;
+			next_light_open = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+		}
+	}
+
+	void BuzzState::CloseLights()
+	{
+		if (light_device)
+		{
+			buzz_write_lights(light_device, {});
+			SDL_hid_close(light_device);
+			light_device = nullptr;
+		}
+		next_light_open = {};
+	}
+
+	static void buzz_handle_reset(USBDevice* dev)
+	{
+		USB_CONTAINER_OF(dev, BuzzState, dev)->CloseLights();
+	}
+#endif
 
